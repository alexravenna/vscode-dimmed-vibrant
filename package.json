  "repository": {
    "type": "git",
    "url": "https://github.com/alexravenna/vscode-dimmed-vibrant.git"
  },
  "bugs": {
    "url": "https://github.com/alexravenna/vscode-dimmed-vibrant/issues"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7"
  }
