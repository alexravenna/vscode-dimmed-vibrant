{
  "name": "dimmed-vibrant",
  "displayName": "Dimmed+Vibrant",
  "description": "A color theme based on the gray-tone editor colors of Monokai Dimmed and the vibrant text colors of Monokai Vibrant",
  "version": "1.0.4",
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": [
    "Themes"    
  ],
  "keywords": [
    "dimmed",
    "vibrant",
    "monokai",
    "theme",
    "color theme"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Dimmed+Vibrant",
        "uiTheme": "vs-dark",
        "path": "./themes/monokai-dimmed-vibrant-color-theme.json"
      }
    ]
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "author": {
    "name": "Alex Ravenna",
    "email": "alex.n.ravenna@gmail.com",
    "url": "https://github.com/alexravenna"
  },
